NODE_ENV=production
PORT=3020
DATABASE_URL=postgresql://companion:CHANGE_ME@127.0.0.1:5432/companion
ASR_PROVIDER=
# Set ASR_PROVIDER=qwen when a real provider key is supplied.
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-filetrans
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# Operator-owned HTTPS origin, without a trailing slash.
HC_PUBLIC_BASE_URL=
# JSON map of device IDs to provisioned bootstrap credentials.
HC_DEVICE_BOOTSTRAPS_JSON={}
# Linux Chinese font file installed by the operator; do not copy macOS fonts.
HC_FONT_FILE=
# SMTP fields are required together when HC_SMTP_HOST is set.
HC_SMTP_HOST=
HC_SMTP_PORT=465
HC_SMTP_SECURE=true
HC_SMTP_USER=
HC_SMTP_PASSWORD=
HC_SMTP_FROM=
# Internal demo only: operator provisions a one-time code; email login remains available.
# After consumption, provision a new random code for the next new-client demonstration.
HC_DEMO_LOGIN_ENABLED=false
HC_DEMO_LOGIN_EMAIL=
HC_DEMO_LOGIN_CODE=
